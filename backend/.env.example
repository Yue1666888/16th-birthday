SERVER_ADDRESS=127.0.0.1
SERVER_PORT=16621
DB_HOST=mysql.example.internal
DB_PORT=3308
DB_NAME=16th_birthday
DB_USER=birthday16_app
DB_PASSWORD=replace-locally
DB_SSL_MODE=REQUIRED
# Integration tests always use 127.0.0.1:3306/birthday16_test.
TEST_DB_USER=birthday16_app
TEST_DB_PASSWORD=replace-with-local-test-password
KEYCLOAK_URL=https://sso.sipc115.com
KEYCLOAK_REALM=member
ADMIN_API_AUDIENCE=account
MAIL_CLIENT_ID=birthday-api-mail
MAIL_CLIENT_SECRET=replace-locally
APP_ENV=development
EMAIL_ENABLED=true
FILE_API_BASE_URL=https://services.sipc115.com/file-api
FILE_IMAGE_HOST=image.sipc115.com
MAIL_API_BASE_URL=https://services.sipc115.com/mail-api
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
APP_TASKS_ENABLED=true
APP_TASKS_DELAY_MS=5000
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Only addresses of the reverse proxies you control; empty ignores all forwarded IP/proto headers.
APP_TRUSTED_PROXIES=
RATE_LIMIT_MEMORY_PER_MINUTE=5
RATE_LIMIT_UPLOADS_PER_MINUTE=20
RATE_LIMIT_MEMBER_UPLOADS_PER_MINUTE=60
RATE_LIMIT_IP_PER_MINUTE=3000
UPLOAD_MAX_CONCURRENT=8
UPLOAD_MAX_WAITING=24
UPLOAD_WAIT_MS=1500
DB_POOL_MAX=10
DB_POOL_WAIT_MS=5000
PUBLIC_CACHE_SECONDS=10
