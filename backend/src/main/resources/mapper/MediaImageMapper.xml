<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sipc115.birthday.media.mapper.MediaImageMapper">
    <sql id="columns">id,url,thumbnail_url,upload_request_id,upload_hash,original_name,uploaded_name,source_mime_type,source_size_bytes,
        stored_size_bytes,width,height,uploader_sub,upload_owner_hash,created_at</sql>
    <insert id="insert">
        INSERT INTO media_images (<include refid="columns"/>)
        VALUES (#{id},#{url},#{thumbnailUrl},#{uploadRequestId},#{uploadHash},#{originalName},#{uploadedName},#{sourceMimeType},#{sourceSizeBytes},
          #{storedSizeBytes},#{width},#{height},#{uploaderSub},#{uploadOwnerHash},#{createdAt})
    </insert>
    <select id="findUpload" resultType="com.sipc115.birthday.media.entity.MediaImageEntity">
      SELECT <include refid="columns"/> FROM media_images WHERE upload_request_id=#{requestId}
      <choose><when test="sub != null">AND uploader_sub=#{sub}</when><otherwise>AND upload_owner_hash=#{ownerHash}</otherwise></choose>
    </select>
    <select id="selectByIds" resultType="com.sipc115.birthday.media.entity.MediaImageEntity">
        SELECT <include refid="columns"/> FROM media_images WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
        ORDER BY id
    </select>
    <select id="lockByIds" resultType="com.sipc115.birthday.media.entity.MediaImageEntity">
        SELECT <include refid="columns"/> FROM media_images WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
        ORDER BY id FOR UPDATE
    </select>
</mapper>
