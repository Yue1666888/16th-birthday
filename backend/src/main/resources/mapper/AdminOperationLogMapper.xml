<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sipc115.birthday.audit.mapper.AdminOperationLogMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_operation_logs
          (actor_sub,actor_name,action,entity_type,entity_id,trace_id,operation_request_id,changes,created_at)
        VALUES
          (#{actorSub},#{actorName},#{action},#{entityType},#{entityId},#{traceId},#{operationRequestId},
           #{changesJson},#{createdAt})
    </insert>
</mapper>
