<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sipc115.birthday.honor.mapper.HonorImageMapper">
  <insert id="insertBatch">
    INSERT INTO honor_images (honor_id,image_id,position) VALUES
    <foreach collection="rows" item="row" separator=",">
      (#{row.honorId},#{row.imageId},#{row.position})
    </foreach>
  </insert>
  <select id="forParents" resultType="com.sipc115.birthday.honor.entity.HonorImageEntity">
    SELECT honor_id,image_id,position FROM honor_images
    WHERE honor_id IN
    <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
    ORDER BY honor_id,position
  </select>
  <delete id="deleteForParent">DELETE FROM honor_images WHERE honor_id=#{id}</delete>
  <select id="claimed" resultType="long">
    SELECT COUNT(*) FROM honor_images WHERE image_id IN
    <foreach collection="ids" item="id" open="(" close=")" separator=",">#{id}</foreach>
  </select>
</mapper>
