<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sipc115.birthday.memory.mapper.MemoryMapper">
  <sql id="columns">id,submission_id,submission_hash,display_name,title,content,published_at</sql>
  <select id="findSubmission" resultType="com.sipc115.birthday.memory.entity.MemoryEntity">
    SELECT <include refid="columns"/> FROM memories WHERE submission_id=#{submissionId}
  </select>
  <select id="findById" resultType="com.sipc115.birthday.memory.entity.MemoryEntity">
    SELECT <include refid="columns"/> FROM memories WHERE id=#{id}
  </select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO memories(submission_id,submission_hash,display_name,title,content,published_at)
    VALUES(#{submissionId},#{submissionHash},#{displayName},#{title},#{content},#{publishedAt})
  </insert>
  <select id="count" resultType="long">SELECT COUNT(*) FROM memories</select>
  <select id="nameCounts" resultType="com.sipc115.birthday.memory.model.MemoryNameCount">
    SELECT TRIM(display_name) COLLATE utf8mb4_bin AS name,COUNT(*) AS submission_count
    FROM memories
    WHERE display_name IS NOT NULL AND CHAR_LENGTH(TRIM(display_name)) > 0
    GROUP BY TRIM(display_name) COLLATE utf8mb4_bin
    ORDER BY submission_count DESC,name ASC
  </select>
  <select id="page" resultType="com.sipc115.birthday.memory.entity.MemoryEntity">
    SELECT <include refid="columns"/> FROM memories
    ORDER BY published_at DESC,id DESC LIMIT #{limit} OFFSET #{offset}
  </select>
</mapper>
